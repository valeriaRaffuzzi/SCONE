type eigenPhysicsPackage;

pop      100000;
active   100;
inactive 50;
XSdata ce;
dataType ce;
outputFile sconeOut;
!seed 1;

collisionOperator { neutronCE {type neutronCEstd;} }

transportOperator { type transportOperatorDT; }

inactiveTally {shannon {type shannonEntropyClerk; cycles 50;
                        map {type spaceMap; axis z; 
                             grid lin; min -34; max 0.0; N 34;}
                       }
              }

activeTally {
  norm totalPow;
  normVal 2.50E+17;
  totalPow  { type collisionClerk; response (fission); fission { type macroResponse; MT -80;}}
  axialPow {type collisionClerk;
         map {type spaceMap; axis z; grid lin; min -34; max 0.0; N 34;}
         response (fission);
         fission { type macroResponse; MT -80;}
         handleVirtual 1;
         }
}

geometry {
  type geometryStd;
  boundary (2 2 0 2 2 0);
  graph {type shrunk;}

  surfaces {
    hexagon { id 1; type zTruncHexagon; origin (0.0 0.0 0.0); orientation 2; halfwidth 0.3795; halfheight 34; }
	cladIn  { id 2; type zCylinder; origin (0.0 0.0 0.0); radius 0.2539; }
	cladOut { id 3; type zCylinder; origin (0.0 0.0 0.0); radius 0.292; }
    top {id 4; type zPlane; z0 0.0;}
  }

  cells {
   pin  {id 1; type simpleCell; surfaces (-4); filltype uni; universe 31;}
   plenum  {id 2; type simpleCell; surfaces (4 -2); filltype mat; material plenum;}
   cladTop {id 3; type simpleCell; surfaces (4 2 -3); filltype mat; material clad;}
   coolTop {id 4; type simpleCell; surfaces (4 3); filltype mat; material cool;}
  }

  universes {
    root { id 1; type rootUniverse; border 1; fill u<2>; }

    pinAndReflect {id 2; type cellUniverse; cells (1 2 3 4);}

    // Pin universes
    pin31 { id 31; type pinUniverse; radii (0.216 0.2539 0.292 0.0 );
                                     fills (fuel  gap    clad  cool);}
  }

}

viz {
	imgY { type bmp; output imgY; what material; centre (0.0 0.0 0.0); axis y; offset 0; res (500 1500); }
	imgZ { type bmp; output imgZ; what material; centre (-10.0 0.0 0.0); axis z; offset 0; res (500 500); }
}

