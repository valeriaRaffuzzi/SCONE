inactiveTally {    }

activeTally {
  norm totalPow;
  normVal 2.0E+20;
  totalPow  { type collisionClerk; response (fission); fission { type macroResponse; MT -80;}}
  radialPow {type collisionClerk;
         map {type multiMap; maps (xx yy); 
			  xx { type spaceMap; axis x; grid lin; min -25.821; max 8.607; N 38; }
			  yy { type spaceMap; axis y; grid lin; min -8.607; max 25.821; N 38; } }
         response (fission);
         fission { type macroResponse; MT -80;}
         handleVirtual 1;
         }
}

coupling {
  tally {
    norm totalPow;
    normVal 2.0E+20;
    totalPow  { type collisionClerk; response (fission); fission { type macroResponse; MT -80;}}
  radialPow {type collisionClerk;
         map {type multiMap; maps (xx yy); 
			  xx { type spaceMap; axis x; grid lin; min -25.821; max 8.607; N 38; }
			  yy { type spaceMap; axis y; grid lin; min -8.607; max 25.821; N 38; } }
         response (fission);
         fission { type macroResponse; MT -80;}
         handleVirtual 1;
         }
  }

maxTemp 2100.0;
receiveFile toSCONE.dat;
sendFile    toDriver.dat;
updateFreq 10;
outputFile sconeOut;
outputFormat asciiMATLAB;
fieldPaths (tempFile densFile geomFile);
fieldNames (temperature density geometry);

