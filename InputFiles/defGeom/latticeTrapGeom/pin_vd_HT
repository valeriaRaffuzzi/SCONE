type eigenPhysicsPackage;

pop      100000;
active   500;
inactive 50;
XSdata ce;
dataType ce;

outputFile pin_vd_HTmatmap;

collisionOperator { neutronCE {type neutronCEstd;} }

transportOperator { type transportOperatorHTField; }

inactiveTally {}

activeTally { flux { type collisionClerk; 
		     response (fiss); fiss {type macroResponse; MT 18;}
		     map { type multiMap; maps (xx yy zz); 
			   xx {type spaceMap; axis x; grid lin; min -25.0; max 25.0; N 100;} 
		   	   yy {type spaceMap; axis y; grid lin; min -5.0; max 5.0; N 1;} 
			   zz {type spaceMap; axis z; grid lin; min -50.0; max 50.0; N 200;}
			 }
		   }
		spectrum { type collisionClerk; 
		     response (flux); flux {type fluxResponse;}
		     map { type energyMap; grid log; min 1.0e-11; max 20.0; N 300;}     
	            } 
}

geometry {
  type geometryStd;
  boundary ( 0 0 0 0 0 0);
  graph {type shrunk;}

surfaces {
    domain { id 1; type box; origin (0.0 0.0 0.0); halfwidth (25.0 25.0 50.0);}

  }

  cells {
  }

  universes {
    root  { id 1; type rootUniverse; border 1; fill u<31>; }
    pin11 { id 11; type pinUniverse; radii (4.0 4.1 4.3 0.0 ); fills (fuel void clad water);}
    pin21 { id 21; type pinUniverse; radii (4.0 4.1 4.3 0.0 ); fills (fuel_vd void_vd clad_vd water_vd);}


    // Lattices
    lat {
      id 31;
      type latUniverse;
      origin (0.0 0.0 0.0);
      pitch (12 12 0);
      shape (4 4 0);
      padMat water;
      map (
        11 11 11 21
        11 11 11 11
        11 11 11 11
        11 11 11 11 ); }

	}
}

geometryDeformation {
  type trapDisplacementField; centre (12 18 0); direction x; r_outer 12; r_flat 1.7; r_shift 10.3; delta 1.8; 
  map {type materialMap; materials (fuel_vd void_vd clad_vd water_vd); }
}

viz {
  img1 { type bmp; output imgY; what material; centre (0.0 0.0 0.0); axis y; offset 0; res (400 800); }
  img2 { type bmp; output imgZ; what material; centre (0.0 0.0 0.0); axis z; offset 0; res (500 500); }
}


