type eigenPhysicsPackage;

pop      500000;
active   500;
inactive 100;
XSdata   ce;
dataType ce;

outputFile lightbridge_vd;

collisionOperator { neutronCE {type neutronCEstd;} }

transportOperator { type transportOperatorDTField; }

inactiveTally {}

activeTally { 

fiss1real { type collisionClerk; tallRealSpace 1;
		     response (fiss); fiss {type macroResponse; MT 18;}
		     map { type multiMap; maps (xx yy zz); 
			   xx {type spaceMap; axis x; grid lin; min -10.71; max 10.71; N 500;} 
		   	   yy {type spaceMap; axis y; grid lin; min -10.71; max 10.71; N 500;} 
			   zz {type spaceMap; axis z; grid lin; min 4.5; max 5.5; N 1;}
			 }
	            } 

fiss2real {type collisionClerk; tallRealSpace 1;
		     response (fiss); fiss {type macroResponse; MT 18;}
		     map { type multiMap; maps (xx yy zz); 
			   xx {type spaceMap; axis x; grid lin; min -10.71; max 10.71; N 500;} 
		   	   yy {type spaceMap; axis y; grid lin; min -10.71; max 10.71; N 500;} 
			   zz {type spaceMap; axis z; grid lin; min 14.5; max 15.5; N 1;}
			 }
	            } 

fiss1map { type collisionClerk; tallRealSpace 0;
		     response (fiss); fiss {type macroResponse; MT 18;}
		     map { type multiMap; maps (xx yy zz); 
			   xx {type spaceMap; axis x; grid lin; min -10.71; max 10.71; N 500;} 
		   	   yy {type spaceMap; axis y; grid lin; min -10.71; max 10.71; N 500;} 
			   zz {type spaceMap; axis z; grid lin; min 4.5; max 5.5; N 1;}
			 }
	            } 

fiss2map { type collisionClerk; tallRealSpace 0;
		     response (fiss); fiss {type macroResponse; MT 18;}
		     map { type multiMap; maps (xx yy zz); 
			   xx {type spaceMap; axis x; grid lin; min -10.71; max 10.71; N 500;} 
		   	   yy {type spaceMap; axis y; grid lin; min -10.71; max 10.71; N 500;} 
			   zz {type spaceMap; axis z; grid lin; min 14.5; max 15.5; N 1;}
			 }
	            } 

}

