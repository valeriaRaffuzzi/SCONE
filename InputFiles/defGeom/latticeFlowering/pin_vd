type eigenPhysicsPackage;

pop      100000;
active   500;
inactive 50;
XSdata ce;
dataType ce;

outputFile pin_vd;

collisionOperator { neutronCE {type neutronCEstd;} }

transportOperator { type transportOperatorDTField; }

inactiveTally {}

activeTally { flux { type collisionClerk; 
		     response (fiss); fiss {type macroResponse; MT 18;}
		     map { type multiMap; maps (xx yy zz); 
			   xx {type spaceMap; axis x; grid lin; min -25.0; max 25.0; N 100;} 
		   	   yy {type spaceMap; axis y; grid lin; min -5.0; max 5.0; N 1;} 
			   zz {type spaceMap; axis z; grid lin; min -50.0; max 50.0; N 200;}
			 }
		   }
		spectrum { type collisionClerk; 
		     response (flux); flux {type fluxResponse;}
		     map { type energyMap; grid log; min 1.0e-11; max 20.0; N 300;}     
	            } 
}

geometry {
  type geometryStd;
  boundary ( 0 0 0 0 0 0);
  graph {type shrunk;}

surfaces {
    domain { id 1; type box; origin (0.0 0.0 0.0); halfwidth (25.0 25.0 50.0);}

  }

  cells {
  }

  universes {
    root  { id 1; type rootUniverse; border 1; fill u<31>; }
    pin11 { id 11; type pinUniverse; radii (3.0 3.1 3.3 0.0 ); fills (fuel void clad water);}

    // Lattices
    lat {
      id 31;
      type latUniverse;
      origin (0.0 0.0 0.0);
      pitch (10 10 0);
      shape (5 5 0);
      padMat water;
      map (
        11 11 11 11 11
        11 11 11 11 11
        11 11 11 11 11
	11 11 11 11 11
	11 11 11 11 11); }
	}
}

geometryDeformation {
  type latDisplacementField; origin (0.0 0.0 0.0); pitch (10 10 0); shape (3 3 0); fields (pos31 pos32 pos33 pos21 pos22 pos23 pos11 pos12 pos13);
	pos11 {type funcDisplacementField; origin (-6.4645 6.4645 0.0); length 50; axis z; function exp; coefficients (0.4 0.03); direction (-1 1); r_outer 10.0; r_flat 1.7; r_shift 8.3; }
	pos12 {type funcDisplacementField; origin ( 0.0000 5.0000 0.0); length 50; axis z; function exp; coefficients (0.4 0.03); direction (0 1);  r_outer 10.0; r_flat 1.7; r_shift 8.3; }
	pos13 {type funcDisplacementField; origin ( 6.4645 6.4645 0.0); length 50; axis z; function exp; coefficients (0.4 0.03); direction (1 1);  r_outer 10.0; r_flat 1.7; r_shift 8.3; }
	pos21 {type funcDisplacementField; origin (-5.0000 0.0000 0.0); length 50; axis z; function exp; coefficients (0.4 0.03); direction (-1 0); r_outer 10.0; r_flat 1.7; r_shift 8.3; }
	pos22 {type funcDisplacementField; origin ( 0.000 0.000 100.0); length 10; axis z; function exp; coefficients (0.4 0.01); direction (1 1);  r_outer -10.0; r_flat 1.7; r_shift 8.3; }
	pos23 {type funcDisplacementField; origin ( 5.0000 0.0000 0.0); length 50; axis z; function exp; coefficients (0.4 0.03); direction (1 0);  r_outer 10.0; r_flat 1.7; r_shift 8.3; }
	pos31 {type funcDisplacementField; origin (-6.4645 -6.4645 0);  length 50; axis z; function exp; coefficients (0.4 0.03); direction (-1 -1); r_outer 10.0; r_flat 1.7; r_shift 8.3; }
	pos32 {type funcDisplacementField; origin (0.0000 -5.0000 0.0); length 50; axis z; function exp; coefficients (0.4 0.03); direction (0 -1); r_outer 10.0; r_flat 1.7; r_shift 8.3; }
	pos33 {type funcDisplacementField; origin (6.4645 -6.4645 0.0); length 50; axis z; function exp; coefficients (0.4 0.03); direction (1 -1); r_outer 10.0; r_flat 1.7; r_shift 8.3; } 

  map {type multiMap; maps (xx yy); 
	   xx {type spaceMap; axis x; grid lin; min -15.0; max 15.0; N 1;} 
	   yy {type spaceMap; axis y; grid lin; min -15.0; max 15.0; N 1;} }
}

viz {
  imgY1 { type bmp; output imgY1; what material; centre (0.0 10.0 0.0); axis y; offset 0; res (400 1200); }
  imgY2 { type bmp; output imgY2; what material; centre (0.0 0.0 0.0); axis y; offset 0; res (400 1200); }
  imgY3 { type bmp; output imgY3; what material; centre (0.0 -10.0 0.0); axis y; offset 0; res (400 1200); }
  imgZ { type bmp; output imgZ; what material; centre (0.0 0.0 49.0); axis z; offset 0; res (500 500); }
}


nuclearData {
  handles {
    ce {type aceNeutronDatabase; aceLibrary $SCONE_ACE;}
  }
  materials {

    water {
      temp 75675;
      rgb (0 0 139); // Colour of water is dark blue
      moder { 1001.03 (h-h2o.42); }
      composition {
      1001.03    6.700E-002;
      8016.03    3.350E-002;
      5010.03    5.560E-006;
      5011.03    2.224E-005; }
      }

     clad {
       composition { 
         40090.03  0.02; 
       }
	}

     fuel {
       temp 900; 
       composition { 
        92234.09  9.1361E-06;
	92235.09  9.3472E-04;
	92238.09  2.1523E-02;
	8016.09  4.4935E-02;} 
       }

}
}
